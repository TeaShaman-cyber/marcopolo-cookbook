{
  "schema_version": "context-routing-fixture-v0.1",
  "documents": {
    "fixture.md": "## Verify\nverify postcondition\n## Shell\nprefer structured route\n## GitHub Write\nuse governed write\n## GitHub Read\nuse read path\n## Budget A\na\n## Budget B\nb\n## Budget C\nc\n"
  },
  "manifest": {
    "schema_version": "cookbook-routing-v0.1",
    "defaults": {
      "max_sections": 2,
      "fallback_route": "default.unknown"
    },
    "policies": {
      "verification": {
        "sections": [{"path": "fixture.md", "heading": "## Verify"}]
      },
      "budget.base": {
        "sections": [
          {"path": "fixture.md", "heading": "## Budget A"},
          {"path": "fixture.md", "heading": "## Budget B"}
        ]
      }
    },
    "routes": [
      {
        "id": "workspace-shell.structured-edit",
        "match": {"surface": "workspace_shell", "operation": "structured_edit"},
        "include": ["verification"],
        "sections": [{"path": "fixture.md", "heading": "## Shell"}]
      },
      {
        "id": "github.governed-mutation",
        "match": {"domain": "github", "operation": "mutation"},
        "include": ["verification"],
        "sections": [{"path": "fixture.md", "heading": "## GitHub Write"}]
      },
      {
        "id": "github.read",
        "match": {"domain": "github", "operation": "read"},
        "include": ["verification"],
        "sections": [{"path": "fixture.md", "heading": "## GitHub Read"}]
      },
      {
        "id": "budget.overflow",
        "match": {"domain": "test", "operation": "budget"},
        "include": ["budget.base"],
        "sections": [{"path": "fixture.md", "heading": "## Budget C"}]
      }
    ]
  },
  "cases": [
    {
      "name": "structured workspace edit",
      "labels": {"surface": "workspace_shell", "operation": "structured_edit"},
      "route_state": "MATCHED",
      "route_id": "workspace-shell.structured-edit",
      "headings": ["## Verify", "## Shell"]
    },
    {
      "name": "github mutation",
      "labels": {"domain": "github", "operation": "mutation"},
      "route_state": "MATCHED",
      "route_id": "github.governed-mutation",
      "headings": ["## Verify", "## GitHub Write"]
    },
    {
      "name": "github read",
      "labels": {"domain": "github", "operation": "read"},
      "route_state": "MATCHED",
      "route_id": "github.read",
      "headings": ["## Verify", "## GitHub Read"]
    },
    {
      "name": "unknown task",
      "labels": {"domain": "unclassified"},
      "route_state": "UNKNOWN",
      "route_id": "default.unknown",
      "headings": []
    },
    {
      "name": "context budget overflow",
      "labels": {"domain": "test", "operation": "budget"},
      "expected_error": "CONTEXT_BUDGET_EXCEEDED"
    }
  ]
}
